# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ (ถ้าไม่มี .env ระบบจะใช้ค่า default ใน docker-compose.yml)

APP_NAME=ระบบบันทึกชั่วโมงทักษะวิชาชีพ
APP_URL=http://localhost:8080
APP_DEBUG=true

WEB_PORT=8080
PMA_PORT=8081
DB_PORT_HOST=3307

DB_NAME=skillhours
DB_USER=skillhours
DB_PASS=skillhours_pass
DB_ROOT_PASS=root_pass

# ----- การเข้าสู่ระบบ -----
# local  = ใช้บัญชีในระบบนี้เท่านั้น
# hybrid = ลองบัญชีในระบบก่อน ถ้าไม่พบจะถาม API มหาวิทยาลัย (ได้ผลแล้วสร้างบัญชีนักศึกษาให้อัตโนมัติ)
AUTH_MODE=local

# ----- API มหาวิทยาลัยเทคโนโลยีราชมงคลศรีวิชัย -----
# none   = ปิด
# mock   = ข้อมูลจำลอง (ใช้ทดสอบระหว่างพัฒนา)
# rmutsv = เรียก API จริงของมหาวิทยาลัย (ตั้งค่า URL/KEY/endpoint ด้านล่าง)
UNI_API_DRIVER=mock
UNI_API_BASE_URL=https://api.example.rmutsv.ac.th
UNI_API_KEY=
UNI_API_TIMEOUT=10
UNI_API_VERIFY_SSL=true
UNI_API_AUTH_ENDPOINT=/auth/login
UNI_API_STUDENT_ENDPOINT=/students/{code}
UNI_API_STAFF_ENDPOINT=/staff/{code}
