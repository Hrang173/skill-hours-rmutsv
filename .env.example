# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ (ถ้าไม่มี .env ระบบจะใช้ค่า default ใน docker-compose.yml)

APP_NAME=ระบบบันทึกชั่วโมงทักษะวิชาชีพ
APP_URL=http://localhost:8080
# true = โหมดพัฒนา: แสดงบัญชีทดลองในหน้าเข้าสู่ระบบ + แสดงรายละเอียด error (ห้ามเปิดตอนให้คนอื่นใช้)
APP_DEBUG=false

WEB_PORT=8080
PMA_PORT=8081
DB_PORT_HOST=3307

DB_NAME=skillhours
DB_USER=skillhours
DB_PASS=skillhours_pass
DB_ROOT_PASS=root_pass

# ----- การเข้าสู่ระบบ -----
# local  = ใช้บัญชีในระบบนี้เท่านั้น
# hybrid = ลองบัญชีในระบบก่อน ถ้าไม่ผ่านจะตรวจกับ API มหาวิทยาลัย (บัญชี RMUTSV)
#          - นักศึกษา: สร้างบัญชีให้อัตโนมัติเมื่อเข้าสู่ระบบครั้งแรก
#          - อาจารย์/บุคลากร: ต้องมีบัญชีที่ฝ่ายทะเบียนสร้างไว้ก่อน (ชื่อผู้ใช้หรืออีเมลตรงกับ RMUTSV)
# ลิงก์ "ลืมรหัสผ่าน?" ในหน้าเข้าสู่ระบบ (เว้นว่าง = ไม่แสดง)
FORGOT_PASSWORD_URL=https://epassport.rmutsv.ac.th/forgot-pass#/forgot-pass-std
AUTH_MODE=local

# ----- API มหาวิทยาลัยเทคโนโลยีราชมงคลศรีวิชัย -----
# none   = ปิด
# mock   = ข้อมูลจำลอง (ใช้ทดสอบระหว่างพัฒนา)
# rmutsv = API จริง  POST https://api.rmutsv.ac.th/elogin  {"username","password"}
UNI_API_DRIVER=mock
# รูปแบบ API (ใช้เมื่อ UNI_API_DRIVER=rmutsv)
#   elogin    = https://api.rmutsv.ac.th + /elogin                                      {"username","password"}
#   epassport = https://epassport.rmutsv.ac.th + /assets/api/logintest_user.php        {"userUid","userPass"}
UNI_API_FORMAT=elogin
UNI_API_BASE_URL=https://api.rmutsv.ac.th
UNI_API_KEY=
UNI_API_TIMEOUT=10
UNI_API_VERIFY_SSL=true
UNI_API_AUTH_ENDPOINT=/elogin
# ยังไม่มี API ค้นหานักศึกษา/บุคลากร — เว้นว่าง
UNI_API_STUDENT_ENDPOINT=
UNI_API_STAFF_ENDPOINT=
# ค่า "type" จาก API ที่ถือว่าเป็นนักศึกษา (ชื่อผู้ใช้ที่เป็นตัวเลขล้วน 10-13 หลักก็นับเป็นนักศึกษา)
UNI_API_STUDENT_TYPES=student,students,std,นักศึกษา
# รับเฉพาะนักศึกษาคณะรหัสเหล่านี้ (faccode คั่นด้วย ,) — ว่าง = ทุกคณะ
UNI_API_ALLOW_FACCODES=
# ช่องที่ใช้เป็นสาขาวิชาของนักศึกษา (RMUTSV ส่งสาขามาใน secname)
UNI_API_MAJOR_FIELD=secname
